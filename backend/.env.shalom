# ════════════════════════════════════════════════════════════════════════════
# CONFIGURACIÓN - SHALOM API
# ════════════════════════════════════════════════════════════════════════════
# Copia este archivo a .env y actualiza con tus valores reales
# NUNCA commitees archivo .env a git
# ════════════════════════════════════════════════════════════════════════════

# ─── API AUTHENTICATION ──────────────────────────────────────────────────────
# Tu clave API de Shalom (requerida)
# Obtén en: https://shalom-api.lat/dashboard/apikey
SHALOM_API_KEY=sk_d6d7a37eec8e5116e9107d50da7849f4cfa5dc0ce82577b7b55f048f7042bd1b

# Tu clave API de Decolecta (requerida para buscar DNI)
# Obtén en: https://decolecta.com/dashboard/apikey
DECOLECTA_API_TOKEN=sk_15993.GqVHqMDvBCLW2XadxNAFcp0HzAJTUWLt

# URL base de Decolecta API (normalmente no cambia)
DECOLECTA_API_BASE_URL=https://api.decolecta.com

# ─── SHALOM PRO CREDENTIALS ──────────────────────────────────────────────────
# Solo necesarios si vas a crear/gestionar órdenes
# Credenciales de tu cuenta Shalom Pro
SHALOM_EMAIL=tu-email@shalom.com
SHALOM_PASSWORD=tu-contraseña-aqui

# ─── CONFIGURACIÓN AVANZADA ─────────────────────────────────────────────────
# URL base de la API (normalmente no cambia)
SHALOM_BASE_URL=https://shalom-api.lat

# Timeout para requests en segundos (default: 30)
SHALOM_TIMEOUT=30

# Número máximo de reintentos en caso de error (default: 3)
SHALOM_MAX_RETRIES=3

# Habilitar logging verboso para debugging (true/false)
SHALOM_VERBOSE=false

# ════════════════════════════════════════════════════════════════════════════
# PASOS PARA CONFIGURAR
# ════════════════════════════════════════════════════════════════════════════
#
# 1. Copiar archivo:
#    $ cp .env.example.shalom .env
#
# 2. Actualizar SHALOM_API_KEY:
#    - Ir a https://shalom-api-peru.com
#    - Iniciar sesión con tu cuenta
#    - Ir a Dashboard > API Settings
#    - Copiar tu API Key
#    - Pegar en SHALOM_API_KEY
#
# 3. (Opcional) Actualizar credenciales Shalom Pro:
#    - SHALOM_EMAIL: Email de tu cuenta Shalom Pro
#    - SHALOM_PASSWORD: Contraseña
#    - Solo necesario si vas a crear guías de envío
#
# 4. Verificar conexión:
#    $ python3 -c "from shalom_api_client import ShalomAPIClient; client = ShalomAPIClient('tu-key'); print(client.health_check())"
#
# ════════════════════════════════════════════════════════════════════════════
